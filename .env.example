# BrandShield AI Configuration
# Copy this file to .env and provide your actual API keys.
# DO NOT commit .env with real secrets to version control.

# Application Environment
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
DATA_DIR=data
STORAGE_DIR=data/storage

# Primary Multimodal & Reasoning AI: Google Gemini API (Recommended: fast, low token cost, multimodal)
# Get your key at https://aistudio.google.com/
GEMINI_API_KEY=

# Alternative Multimodal & Reasoning AI: OpenAI API (gpt-4o-mini / gpt-4o)
# Get your key at https://platform.openai.com/
OPENAI_API_KEY=

# Lightweight Specialized NLP / Emotion & Sentiment API: Hugging Face Inference API
# Get your key at https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# Model Selection Defaults
DEFAULT_VISION_MODEL=gemini-2.5-flash
DEFAULT_TEXT_MODEL=gemini-2.5-flash
DEFAULT_EMBEDDING_MODEL=text-embedding-004
