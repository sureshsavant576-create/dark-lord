# BrandShield AI Configuration (Exclusively Google Gemini AI)
# Copy this file to .env and provide your Gemini API key.
# DO NOT commit .env with real secrets to version control.

# Application Environment
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
DATA_DIR=data
STORAGE_DIR=data/storage

# Primary & Exclusive Multimodal AI: Google Gemini API
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=

# Model Defaults
DEFAULT_VISION_MODEL=gemini-3.5-flash-lite
DEFAULT_TEXT_MODEL=gemini-3.5-flash-lite
DEFAULT_EMBEDDING_MODEL=gemini-embedding-001
